    "ax.set_xlabel(r'$\\log_{10}\\,(P\\,/\\,\\mathrm{days})$', fontsize=13)\n",
    "ax.set_ylabel('Count', fontsize=13)\n",
    "ax.set_title('Period distribution of drawn binaries', fontsize=12)\n",
