    "from BinaryStarGenerator import BinaryStarGenerator\n",
    "sample = BinaryStarGenerator()\n",
    "\n",
    "# Define pdf's to test careful f(e) is required!\n",
    "def thermal_eccentricity(e):\n",
    "    return 2*e\n",
    "\n",
    "def uniform_eccentricity(e):\n",
    "    return np.ones_like(e)\n",
    "\n",
    "\n",
    "# combination of both\n",
    "separations = semi_major_ax # Add synthetic semi major axis (in AU) population here!!\n",
    "f_thermal   = np.mean(separations >= 100)\n",
    "f_uniform   = 1 - f_thermal\n",
    "\n",
    "periods      = 10**samples # Add synthetic period (in days) population here!!\n",
    "f_normal     = np.mean(periods >= 7)       # non-circularised\n",
    "f_circulized = 1 - f_normal                # periods < 7 days → e = 0\n",
    "print(f_circulized,f_normal)\n",
    "def uniform_and_thermal(e, f_uniform=f_uniform, f_thermal=f_thermal,\n",
    "                            f_normal=f_normal, f_circulized=f_circulized):\n",
    "    \"\"\"\n",
    "    Mixture PDF combining separation and period conditions:\n",
    "      - periods < 7 days  (f_circulized): e = 0  → delta spike at e=0\n",
    "      - periods >= 7 days (f_normal):     mixture of uniform and thermal\n",
    "    \"\"\"\n",
    "    # Continuous mixture for non-circularised systems\n",
    "    pdf_continuous = f_uniform * uniform_eccentricity(e) + f_thermal * thermal_eccentricity(e)\n",
    "\n",
    "    # Delta spike at e = 0 for circularised systems\n",
    "    spike_width = 1e-2\n",
    "    pdf_spike   = f_circulized * np.exp(-0.5 * (e / spike_width)**2) / (spike_width * np.sqrt(2 * np.pi))\n",
    "\n",
    "    return f_normal * pdf_continuous + pdf_spike\n",
    "# draw samples\n",
    "samples_thermal = sample.generate_single(thermal_eccentricity,(0,1),len( df_synthetic[\"e\"]))\n",
    "samples_uniform = sample.generate_single(uniform_eccentricity,(0,1),len( df_synthetic[\"e\"]))\n",
    "samples_both = sample.generate_single(uniform_and_thermal,(0,1),len( df_synthetic[\"e\"]))\n",
    "# save in dataframe\n",
    "df_compare = pd.DataFrame({\n",
    "    \"uniform\": samples_uniform,\n",
    "    \"thermal\": samples_thermal,\n",
    "    \"both\" : samples_both,\n",
    "    \"Moe & Di Stefano (2017)\": df_synthetic[\"e\"].values\n",
    "})\n",
    "\n",
    "pdfs = [\n",
    "    uniform_eccentricity,   # col 0 - uniform:  f(e) = 1\n",
    "    thermal_eccentricity,   # col 1 - thermal:  f(e) = 2e\n",
    "    uniform_and_thermal,    # col 2 - both: f(e) = 1 for a < 100AU and f(e) = 2e for a > 100AU\n",
    "    None,                   # col 2 - Moe & Di Stefano (2017): empirical, no PDF\n",
    "]\n",
    "\n",
    "analysis = BinaryPopulationAnalysis(\n",
    "    df_synthetic = df_compare,\n",
    "    synth_cols   = [\"both\"],\n",
    "    obs_cols     = [\"e\"],\n",
    "    col_labels   = [\"e\"]\n",
    ")\n",
    "\n",
    "for name, df_obs in [(\"SB9\", df_SB9), (\"ORB6\", df_ORB6)]:\n",
    "    bins, synth_hist, obs_hist, bias_hist = analysis.generate_histograms(df_obs)\n",
    "    analysis.plot_histograms(bins, synth_hist, obs_hist, bias_hist,\n",
    "                             pdfs=pdfs,\n",
    "                             save_path=f\"Media/eccentricity_vs_{name}.pdf\")\n"
   ],
