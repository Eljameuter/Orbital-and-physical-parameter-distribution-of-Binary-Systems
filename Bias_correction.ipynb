    "from scipy.interpolate import interp1d\n",
    "alpha_fcn = pd.read_csv(r'DATA/etoa.csv')\n",
    "\n",
    "def thermal_and_super_thermal(seperation): # seperation in AU!\n",
    "    if seperation > 100:\n",
    "        def pdf(e):\n",
    "            return 2*e\n",
    "        return pdf\n",
    "    else:\n",
    "        def pdf(e):\n",
    "            return np.ones_like(e)\n",
    "        return pdf\n",
    "\n",
    "def get_alpha(a, fcn=alpha_fcn):\n",
    "    loga = np.log10(a)\n",
    "    x = np.asarray(fcn[\"x\"])   # separations\n",
    "    y = np.asarray(fcn[\"y\"])   # alpha values\n",
    "\n",
    "    # interpolation function\n",
    "    interp = interp1d(x,y,kind=\"linear\",bounds_error=False,fill_value=\"extrapolate\")\n",
    "\n",
    "    return interp(loga)\n",
    "\n",
    "\n",
    "# define f(e | a) = e^alpha\n",
    "def hwang_eccentricities(separation):\n",
    "    alpha = get_alpha(separation)\n",
    "\n",
    "    def pdf(e):\n",
    "        return (e)**alpha\n",
    "\n",
    "    return pdf\n",
    "\n",
    "seperations = 200* np.random.rand(len(df_synthetic))# generate random semimajor axis values\n",
    "\n",
    "samples_hwang = sample.generate_variable(thermal_and_super_thermal,(0, 1), seperations) # seperations in AU!\n",
    "\n",
    "\n",
    "df_compare = df_compare.assign(\n",
    "    **{\"Hwang et. al (2021)\": pd.Series(samples_hwang).values}\n",
    ")\n",
    "\n",
    "\n",
    "analysis = BinaryPopulationAnalysis(\n",
    "    df_synthetic = df_compare,\n",
    "    synth_cols   = [\"uniform\",\"thermal\",\"Hwang et. al (2021)\", \"Moe & Di Stefano (2017)\"],\n",
    "    obs_cols     = [\"e\",\"e\",\"e\",\"e\"]\n",
    ")\n",
    "\n",
    "for name, df_obs in [(\"SB9\", df_SB9), (\"ORB6\", df_ORB6)]:\n",
